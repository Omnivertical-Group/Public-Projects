{
  "name": "Intel C++ + Python Dev",

  "build": {
    "dockerfile": "Dockerfile"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-vscode.cmake-tools",
        "ms-vscode.makefile-tools",
        "llvm-vs-code-extensions.vscode-clangd"
      ]
    }
  },

  "postCreateCommand": "bash -lc 'source /opt/intel/oneapi/setvars.sh && conda activate dev'",

  "remoteUser": "root"
}
